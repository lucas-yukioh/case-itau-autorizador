{
  "id": null,
  "title": "Autorizador Dashboard",
  "tags": ["springboot", "micrometer", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Successful Transactions",
      "targets": [{ "expr": "transactions_success_total" }],
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "stat",
      "title": "Failed Transactions",
      "targets": [{ "expr": "transactions_failed_total" }],
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "graph",
      "title": "Transactions Per Second",
      "targets": [{ "expr": "rate(transactions_success_total[1m])" }],
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 6 }
    },
    {
      "type": "graph",
      "title": "HTTP Requests Per Second",
      "targets": [{ "expr": "rate(http_server_requests_seconds_count[1m])" }],
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 6 }
    },
    {
      "type": "graph",
      "title": "Database Query Time (avg)",
      "targets": [
        {
          "expr": "avg(rate(hikaricp_connections_acquire_seconds_sum[1m]) / rate(hikaricp_connections_acquire_seconds_count[1m]))"
        }
      ],
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 6 }
    },
    {
      "type": "graph",
      "title": "SQS Messages Available",
      "targets": [{ "expr": "sqs_messages_visible" }],
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 6 }
    },
    {
      "type": "graph",
      "title": "SQS Messages In-flight",
      "targets": [{ "expr": "sqs_messages_inflight" }],
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 6 }
    },
    {
      "type": "graph",
      "title": "SQS Messages Delayed",
      "targets": [{ "expr": "sqs_messages_delayed" }],
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 6 }
    },
    {
      "type": "graph",
      "title": "JVM Memory Usage",
      "targets": [{ "expr": "jvm_memory_used_bytes" }],
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 6 }
    },
    {
      "type": "graph",
      "title": "System CPU Usage",
      "targets": [{ "expr": "system_cpu_usage" }],
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 6 }
    }
  ]
}
